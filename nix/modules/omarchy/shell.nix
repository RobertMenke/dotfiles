{ config, lib, ... }:
let
  fish = "${config.home.homeDirectory}/.local/bin/fish";
in
{
  # The login shell stays omarchy's /usr/bin/bash on purpose: fish here is a
  # nix store path, and a login shell that can vanish (nix broken, store
  # path gc'd) would lock the account out. Instead bash hands off to fish
  # wherever a human is typing, and SHELL points at fish so programs that
  # spawn "the user's shell" pick it too.

  # Desktop session: everything launched from Hyprland sees SHELL=fish.
  xdg.configFile."uwsm/env".text = lib.mkAfter ''
    [ -x "${fish}" ] && export SHELL="${fish}"
  '';

  # Omarchy's stock ~/.bashrc, plus the hand-off at the end. Replaces the
  # file omarchy installs (first switch needs `-b bak`).
  home.file.".bashrc".text = ''
    # Generated by home-manager (nix/modules/omarchy/shell.nix).

    # Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
    [[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

    # If not running interactively, don't do anything else (leave this above the rc source)
    [[ $- != *i* ]] && return

    # All the default Omarchy aliases and functions
    # (don't mess with these directly, just overwrite them here!)
    source "$OMARCHY_PATH/default/bash/rc"

    # Hand interactive shells (TTY, SSH, terminals) over to fish. Skipped
    # when fish itself started this bash (typing `bash` in fish gives you
    # bash), for `bash -c` commands, and if the nix fish is missing, so a
    # broken nix install still leaves a working bash.
    if [[ -x "${fish}" && -z $BASH_EXECUTION_STRING && $(ps -o comm= -p $PPID) != fish ]]; then
      export SHELL="${fish}"
      shopt -q login_shell && exec "${fish}" --login
      exec "${fish}"
    fi
  '';
}
