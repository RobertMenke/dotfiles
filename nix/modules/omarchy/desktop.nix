{ config, pkgs, ... }:
{
  # Non-NixOS Linux: sets XDG_DATA_DIRS etc. so nix-installed apps are found,
  # and `gpu` makes nix GUI apps (ghostty, alacritty) able to load the host's
  # mesa/GL drivers. The GPU half needs root once; activation prints the
  # exact command (`sudo .../non-nixos-gpu-setup`) until it has been run.
  targets.genericLinux = {
    enable = true;
    gpu.enable = true;
  };

  # Ghostty is the daily-driver terminal on the macs too, where it comes from
  # /Applications rather than nix. Its config is wired up in
  # ../home/dotfiles.nix.
  home.packages = [ pkgs.ghostty ];

  xdg.configFile = {
    # Hyprland is started by uwsm, which doesn't read /etc/profile.d, so the
    # session (and everything launched from it: terminals, the omarchy
    # launcher, `xdg-terminal-exec`) would otherwise never see nix. uwsm
    # sources this file with sh after omarchy's own env.d/10-omarchy.
    #
    # Deliberately not hm-session-vars.sh: that would also export EDITOR and
    # TERM session-wide and change how omarchy's own menus open files.
    # Shells pick those up themselves.
    "uwsm/env".text = ''
      # Generated by home-manager (nix/modules/omarchy/desktop.nix).
      if [ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
      fi
      export XDG_DATA_DIRS="${config.home.profileDirectory}/share:/nix/var/nix/profiles/default/share:''${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    '';

    # Omarchy's `Super + Return` / $TERMINAL go through xdg-terminal-exec,
    # which picks the first entry here (omarchy defaults to foot).
    "xdg-terminals.list".text = ''
      com.mitchellh.ghostty.desktop
    '';

    # tmux loads *every* config it finds, ~/.tmux.conf first and then
    # ~/.config/tmux/tmux.conf, so omarchy's stock file there would be
    # applied on top of ours (../home/dotfiles.nix) and win every conflict.
    # Replace it with an empty one.
    "tmux/tmux.conf".text = ''
      # Intentionally empty: the real config is ~/.tmux.conf (managed by
      # home-manager from ~/dotfiles/tmux.conf). tmux reads both files, so
      # this one exists only to replace omarchy's default.
    '';
  };
}
