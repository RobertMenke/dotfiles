{
  config,
  lib,
  pkgs,
  ...
}:
# ---------------------------------------------------------------------------
# rEFInd boot menu, "Choose Your Fate" theme: Windows (blue pill, left hand)
# or Omarchy (red pill, right hand).
#
# home-manager runs as the user and can't write to the ESP, so this is split
# in two:
#
#   * At build time, nix assembles the complete EFI/refind directory
#     (binary, refind.conf, theme) in the store. That is the declarative,
#     versioned part: change an option here, `nh home switch`, done.
#   * `refind-sync` (installed on $PATH) copies that tree to
#     ${esp}/EFI/refind with sudo and makes sure rEFInd is first in the
#     firmware boot order. Activation warns whenever the tree has changed
#     since the last sync, so the ESP can't silently drift from this file.
#
# Omarchy still boots through Limine: the "Omarchy" entry chainloads it, which
# keeps LUKS unlock, Plymouth and the snapper snapshot menu working. Limine's
# own files on the ESP are omarchy's and are never touched here.
# ---------------------------------------------------------------------------
let
  cfg = config.myConfig.refind;
  inherit (cfg) esp;

  theme = pkgs.fetchFromGitHub {
    owner = "SammyNashed";
    repo = "refind-choose-your-fate";
    rev = "af1bd7b0b79976eae3f53f2fdfddced5bb211287";
    hash = "sha256-awKklrrhXSjiy7iCOInMkP27LxwwXtNRK+r7Xu4A6Xg=";
  };
  themeDir = "themes/refind-choose-your-fate";

  refindConf = pkgs.writeText "refind.conf" ''
    # Generated by home-manager (nix/modules/omarchy/refind.nix); edit that
    # file and run `refind-sync` instead of editing this copy on the ESP.
    timeout ${toString cfg.timeout}
    # The theme is laid out for 1920x1080; on the 4K screen this keeps the
    # pills in the hands.
    resolution ${cfg.resolution}
    scanfor manual

    # rEFInd lists manual entries in file order: first one is the left hand.

    # Left hand / blue pill
    menuentry "Windows" {
        icon   /EFI/refind/${themeDir}/icons/os_win.png
        volume ${cfg.windowsPartUuid}
        loader /EFI/Microsoft/Boot/bootmgfw.efi
    }

    # Right hand / red pill -- chainloads Limine
    menuentry "Omarchy" {
        icon   /EFI/refind/${themeDir}/icons/os_arch.png
        loader /EFI/limine/limine_x64.efi
    }

    include ${themeDir}/theme.conf
  '';

  # Exactly what EFI/refind should contain. Mirrors the theme's own
  # install.sh (theme.conf, backgrounds, selection images, icons) without
  # its in-place sed edits to refind.conf.
  tree = pkgs.runCommand "refind-esp-tree" { } ''
    mkdir -p $out/${themeDir}/icons
    cp ${pkgs.refind}/share/refind/refind_x64.efi $out/
    cp ${refindConf} $out/refind.conf
    cp ${theme}/theme.conf ${theme}/background*.png ${theme}/selection_*.png $out/${themeDir}/
    cp ${theme}/icons/*.png $out/${themeDir}/icons/
  '';

  stamp = "${config.xdg.stateHome}/refind-sync/synced";

  # The privileged half. Takes the tree as an argument so a stale copy of
  # this script can never install a different tree than the caller asked for.
  syncRoot = pkgs.writeShellApplication {
    name = "refind-sync-root";
    runtimeInputs = with pkgs; [
      coreutils
      diffutils
      efibootmgr
      gnused
      util-linux
    ];
    text = ''
      [[ $EUID -eq 0 ]] || { echo "refind-sync-root: must run as root" >&2; exit 1; }
      src=$1
      esp=${lib.escapeShellArg esp}
      dest="$esp/EFI/refind"

      mountpoint -q "$esp" || { echo "$esp is not mounted" >&2; exit 1; }
      [[ -f $esp/EFI/limine/limine_x64.efi ]] ||
        { echo "Limine not found at $esp/EFI/limine; refusing to install a menu that can't boot Omarchy" >&2; exit 1; }

      mkdir -p "$dest"
      if [[ -f $dest/refind.conf ]] && ! cmp -s "$src/refind.conf" "$dest/refind.conf"; then
        cp "$dest/refind.conf" "$dest/refind.conf.bak-$(date +%Y%m%d-%H%M%S)"
      fi
      # The ESP is FAT: modes and owners mean nothing there, and the store's
      # read-only bits would only get in the way of the next sync.
      install -m 644 "$src/refind_x64.efi" "$src/refind.conf" "$dest/"
      rm -rf "''${dest:?}/${themeDir}"
      mkdir -p "$dest/themes"
      cp -r --no-preserve=mode,ownership "$src/${themeDir}" "$dest/themes/"
      echo "Installed $src -> $dest"

      ${lib.optionalString cfg.manageBootOrder ''
        # Firmware boot entry, first in BootOrder. The disk and partition
        # number come from whatever is mounted at the ESP.
        part_dev=$(findmnt -no SOURCE "$esp")
        disk="/dev/$(lsblk -no PKNAME "$part_dev")"
        part=$(cat "/sys/class/block/$(basename "$part_dev")/partition")

        if ! efibootmgr | grep -q 'rEFInd'; then
          efibootmgr --create --disk "$disk" --part "$part" \
                     --loader '\EFI\refind\refind_x64.efi' --label rEFInd >/dev/null
        fi
        num=$(efibootmgr | sed -n 's/^Boot\([0-9A-F]\{4\}\)\* rEFInd.*/\1/p' | head -1)
        order=$(efibootmgr | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -v "^$num$" | paste -sd, || true)
        efibootmgr --bootorder "$num''${order:+,$order}" >/dev/null
        efibootmgr | grep -E '^BootOrder'
      ''}
    '';
  };

  sync = pkgs.writeShellApplication {
    name = "refind-sync";
    runtimeInputs = [ pkgs.coreutils ];
    text = ''
      tree=${tree}
      # sudo comes from the host (it has to be setuid), not from nix.
      /usr/bin/sudo ${syncRoot}/bin/refind-sync-root "$tree"
      mkdir -p "$(dirname ${lib.escapeShellArg stamp})"
      echo "$tree" > ${lib.escapeShellArg stamp}
    '';
  };
in
{
  options.myConfig.refind = {
    enable = lib.mkEnableOption "the nix-built rEFInd menu, installed to the ESP by `refind-sync`";
    esp = lib.mkOption {
      type = lib.types.str;
      default = "/boot";
      description = "Mount point of the ESP that holds EFI/limine (and gets EFI/refind).";
    };
    windowsPartUuid = lib.mkOption {
      type = lib.types.str;
      description = "PARTUUID of the ESP holding EFI/Microsoft/Boot/bootmgfw.efi.";
    };
    timeout = lib.mkOption {
      type = lib.types.int;
      default = 10;
      description = "Seconds before rEFInd boots the default entry.";
    };
    resolution = lib.mkOption {
      type = lib.types.str;
      default = "1920 1080";
      description = "rEFInd `resolution` line. The theme art is drawn for 1920x1080.";
    };
    manageBootOrder = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Have `refind-sync` create the rEFInd firmware entry and keep it first in BootOrder.";
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ sync ];

    home.activation.refindStatus = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
      if [[ "$(cat ${lib.escapeShellArg stamp} 2>/dev/null)" != ${tree} ]]; then
        warnEcho "rEFInd: the menu on ${esp} doesn't match this generation. Run: refind-sync"
      fi
    '';
  };
}
