# =============================================================================
#  AeroSpace — https://nikitabobko.github.io/AeroSpace/guide
# =============================================================================
#
#  Port of the yabai + skhd setup (../yabai/yabairc, ../skhd/skhdrc).
#  Every keybinding below keeps the original `alt + ctrl` chord scheme, so
#  muscle memory carries over. Differences from yabai are called out inline
#  with "NOTE:".
#
#  Used on every host. Symlinked to ~/.config/aerospace by
#  nix/modules/home/dotfiles.nix. On the personal mac
#  `myConfig.dotfiles.liveSourceDir` points at the live checkout, so edits
#  here apply without a rebuild: save, then hit `alt + ctrl - r`
#  (reload-config). On the work mac that option is null, so this file is
#  copied into the nix store and changes need a `nh darwin switch`.
#
#  Targets AeroSpace 0.20.3-Beta, the version in the pinned nixpkgs. Unknown
#  keys are a hard parse error, so `auto-reload-config` and
#  `focus-follows-mouse` are deliberately absent — both landed in 0.21.x.
#
#  yabai and AeroSpace both want to own every window, so only one runs at a
#  time. Switch with `myConfig.windowManager` in nix/hosts/<host>/default.nix.
#
# =============================================================================

config-version = 2

start-at-login = false        # launchd owns the lifecycle (services.aerospace)

# -- Layout ------------------------------------------------------------------

# yabai: `layout bsp`. AeroSpace's 'tiles' is the equivalent tiling layout.
default-root-container-layout = 'tiles'

# 'auto' = wide monitors split horizontally, tall monitors vertically.
default-root-container-orientation = 'auto'

# NOTE: yabai's `window_placement second_child` has no config knob here.
# AeroSpace always inserts a new window next to the focused one, which lands
# in the same place `second_child` did.
enable-normalization-flatten-containers = true
enable-normalization-opposite-orientation-for-nested-containers = true

accordion-padding = 30

# yabai: top/bottom/left/right_padding 4, window_gap 4.
gaps.inner.horizontal = 4
gaps.inner.vertical   = 4
gaps.outer.left       = 4
gaps.outer.bottom     = 4
gaps.outer.top        = 4
gaps.outer.right      = 4

# -- Workspaces --------------------------------------------------------------

# AeroSpace workspaces are virtual and replace macOS Spaces entirely. The skhd
# config addressed spaces 1-7, so keep those seven alive even when empty.
#
# NOTE: turn off System Settings > Keyboard > Keyboard Shortcuts > Mission
# Control > "Switch to Desktop N" (ctrl-1..7) — those still drive real macOS
# Spaces and will fight the bindings below.
persistent-workspaces = ["1", "2", "3", "4", "5", "6", "7"]

# -- Mouse -------------------------------------------------------------------

# NOTE: yabai had `mouse_follows_focus` commented out (i.e. off), which is
# already AeroSpace's behaviour. The explicit `focus-follows-mouse` key only
# exists in 0.21+, so there is nothing to set here.

# Recenter the pointer when the focused monitor changes (AeroSpace default).
on-focused-monitor-changed = ['move-mouse monitor-lazy-center']

# NOTE: no equivalent for yabai's `mouse_action1 move` / `mouse_action2 resize`
# / `mouse_drop_action swap`. AeroSpace does not intercept mouse drags at all;
# dragging a titlebar falls through to macOS and AeroSpace re-tiles on drop.

key-mapping.preset = 'qwerty'

# -- Unmanaged apps ----------------------------------------------------------
#
# yabai: `rule --add app="^...$" manage=off`. AeroSpace matches on bundle id.

[[on-window-detected]]
if.app-id = 'com.apple.systempreferences'   # System Settings
run = ['layout floating']

[[on-window-detected]]
if.app-id = 'com.apple.calculator'          # Calculator
run = ['layout floating']

[[on-window-detected]]
if.app-id = 'com.apple.QuickTimePlayerX'    # QuickTime Player
run = ['layout floating']

[[on-window-detected]]
if.app-id = 'pl.maketheweb.cleanshotx'      # CleanShot X
run = ['layout floating']

[[on-window-detected]]
if.app-id = 'com.jetbrains.toolbox'         # JetBrains Toolbox
run = ['layout floating']

# =============================================================================
#  Keybindings
# =============================================================================

[mode.main.binding]

    # -- Changing window focus -----------------------------------------------
    alt-ctrl-h = 'focus left'
    alt-ctrl-j = 'focus down'
    alt-ctrl-k = 'focus up'
    alt-ctrl-l = 'focus right'

    # Change focus between external displays.
    alt-ctrl-shift-p = 'focus-monitor left'
    alt-ctrl-shift-n = 'focus-monitor right'

    # -- Layout orientation --------------------------------------------------
    #
    # NOTE: AeroSpace has no `space --mirror` or `space --rotate`. The closest
    # behaviour is toggling the orientation of the focused container.
    alt-ctrl-y = 'layout tiles horizontal vertical'
    alt-ctrl-x = 'layout accordion horizontal vertical'

    # -- Modifying window size -----------------------------------------------
    alt-ctrl-f = 'fullscreen'        # yabai: --toggle zoom-fullscreen
    alt-ctrl-b = 'balance-sizes'     # yabai: space --balance

    # No yabai equivalent — AeroSpace has no `auto_balance`, so manual resize
    # earns its keys here.
    alt-ctrl-minus = 'resize smart -50'
    alt-ctrl-equal = 'resize smart +50'

    # -- Moving windows around -----------------------------------------------
    alt-ctrl-shift-h = 'move left'
    alt-ctrl-shift-j = 'move down'
    alt-ctrl-shift-k = 'move up'
    alt-ctrl-shift-l = 'move right'

    # Move window to display left/right, following it with focus.
    alt-ctrl-p = 'move-node-to-monitor --focus-follows-window left'
    alt-ctrl-n = 'move-node-to-monitor --focus-follows-window right'

    # Move window to prev/next workspace, following it with focus.
    # NOTE: diverges from yabai, where `window --space prev|next` left focus
    # behind on the workspace you sent the window from.
    alt-ctrl-a = 'move-node-to-workspace --wrap-around --focus-follows-window prev'
    alt-ctrl-d = 'move-node-to-workspace --wrap-around --focus-follows-window next'

    # Move window to workspace #, following it with focus.
    alt-ctrl-1 = 'move-node-to-workspace --focus-follows-window 1'
    alt-ctrl-2 = 'move-node-to-workspace --focus-follows-window 2'
    alt-ctrl-3 = 'move-node-to-workspace --focus-follows-window 3'
    alt-ctrl-4 = 'move-node-to-workspace --focus-follows-window 4'
    alt-ctrl-5 = 'move-node-to-workspace --focus-follows-window 5'
    alt-ctrl-6 = 'move-node-to-workspace --focus-follows-window 6'
    alt-ctrl-7 = 'move-node-to-workspace --focus-follows-window 7'

    # -- Switching workspaces ------------------------------------------------
    #
    # No skhd equivalent: under yabai these were macOS Spaces, switched with
    # ctrl-1..7 / Mission Control. AeroSpace workspaces are its own, so they
    # need real bindings. `alt-N` is the AeroSpace default.
    alt-1 = 'workspace 1'
    alt-2 = 'workspace 2'
    alt-3 = 'workspace 3'
    alt-4 = 'workspace 4'
    alt-5 = 'workspace 5'
    alt-6 = 'workspace 6'
    alt-7 = 'workspace 7'

    # Step to the prev/next workspace. Counterpart to alt-ctrl-a / alt-ctrl-d
    # above, which move the focused window in the same direction.
    alt-p = 'workspace --wrap-around prev'
    alt-n = 'workspace --wrap-around next'

    # Jump back to the previously focused workspace, à la nvim's ctrl-o/ctrl-i.
    # NOTE: AeroSpace keeps only one step of history — there is no jump list —
    # so both keys are the same toggle rather than back/forward through a stack.
    alt-o = 'workspace-back-and-forth'
    alt-i = 'workspace-back-and-forth'

    alt-tab = 'workspace-back-and-forth'
    alt-ctrl-shift-tab = 'move-workspace-to-monitor --wrap-around next'

    # -- Service -------------------------------------------------------------
    alt-ctrl-r = 'reload-config'   # skhd: restart yabai

    # skhd: stop yabai. NOTE: while AeroSpace is disabled it stops intercepting
    # keys, so there is no binding that can turn it back on — re-enable from a
    # shell with `aerospace enable on`.
    alt-ctrl-q = 'enable off'

    alt-ctrl-semicolon = 'mode service'

[mode.service.binding]
    esc = ['reload-config', 'mode main']
    r = ['flatten-workspace-tree', 'mode main']   # reset layout
    f = ['layout floating tiling', 'mode main']   # toggle floating/tiling
    backspace = ['close-all-windows-but-current', 'mode main']

    # yabai's `window --warp <dir>`, which skhd had commented out.
    alt-ctrl-shift-h = ['join-with left', 'mode main']
    alt-ctrl-shift-j = ['join-with down', 'mode main']
    alt-ctrl-shift-k = ['join-with up', 'mode main']
    alt-ctrl-shift-l = ['join-with right', 'mode main']
